# Pinned workload descriptor: the packed 7B workload with a STANDARD LR SCHEDULE (2026-10-16).
#
# Identical to qwen2_5_math_7b_packed.env (which stays byte-identical: six bundles pin its sha256)
# except for the learning-rate schedule. The user's rule, 2026-10-16: follow general default training
# practice (warmup is fine) and keep it FIXED during optimisation -- "no tuning" never meant "constant
# LR". The previous constant-LR/no-warmup recipe was marginally stable: every arm showed grad-norm
# excursions and the accepted kernel stack tipped it into catastrophic late episodes
# (knowledge/gate_convergence.md, P0-4b). Schedule, chosen as the common SFT default, not tuned:
#   peak LR 1e-5 (unchanged), linear warmup over 3% of the run, cosine decay to 10% of peak.
# LR_DECAY_ITERS is the planned run length: 358 = one epoch of the train19k pack at GBS 16 (the
# quality experiments). A different run length needs its own descriptor value -- the schedule is part
# of workload identity (config_digest).
#
#
# Same model, data, parallel mapping and optimizer as qwen2_5_math_7b.env; the conversations are
# packed into 4096-token sequences by scripts/pack_sft.py (3.31 per pack, 97.5% fill). Packing was
# accepted by the workflow on its own on 2026-10-09 (+258% equal-useful-token, gate PASS) and every
# kernel win measured on the unpacked workload turned out to be a padding win (+0.1-0.3% here), so
# kernel work on this model should run on THIS descriptor.
WORKLOAD_NAME=qwen2_5_math_7b_packed_cosine
MODEL_CKPT=/models/qwen2_5_math_7b_torch_dist
TOKENIZER_DIR=/models/qwen2_5_math_7b
ROPE_BASE=10000
ARCH_ARGS="--num-layers 28 --hidden-size 3584 --ffn-hidden-size 18944
           --num-attention-heads 28 --group-query-attention --num-query-groups 4
           --kv-channels 128 --untie-embeddings-and-output-weights"
SEQ=4096
MBS=1

# GBS COUNTS PACKS. 16 packs ~= 53 conversations per optimizer step. CONFIRMED 2026-10-15
# (DECISIONS 4.21): closest to the LR-tuned 64 conversations without exceeding it.
GBS=16

# The packed dataset -- only if the caller did not pass --data. This file is sourced AFTER argument
# parsing, so a plain assignment here would silently override an explicit --data.
_PACKED=/work/data/sft_ultrachat20k_packed_7b_cfg1009.jsonl
[ "$DATA_PATH" = /work/data/sft_ultrachat20k.jsonl ] && DATA_PATH="$_PACKED"

# Across-job floor. Three same-identity null pairs of THIS descriptor (two jobs today plus one from
# an earlier session): paired deltas +0.030, -0.036, +0.009%; throughput 2874.2 / 2874.4 / 2874.5.
# Three pairs are too few to set a floor on their own, so this takes the unpacked 7B floor, which
# 400 clean pairs put at 0.25% (worst 0.225%) -- 7x the worst packed null seen. Re-run
# scripts/calibrate_band.py once this descriptor has more legs and tighten it on evidence.
ACROSS_JOB_FLOOR_PCT=0.25

# Standard LR schedule (see header). Read by scripts/adapters/megatron.sh; absent in older descriptors,
# where the adapter keeps its historical constant-LR defaults.
LR=1.0e-5
MIN_LR=1.0e-6
LR_DECAY_STYLE=cosine
LR_WARMUP_ITERS=11
LR_DECAY_ITERS=358
