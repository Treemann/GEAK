# Pinned workload descriptor (Seam 1, descriptor role). Sourced by bench_train.sh.
# Arch args are taken from the checkpoint's own common.pt, never guessed.
WORKLOAD_NAME=qwen2_5_0_5b
MODEL_CKPT=/models/qwen2_5_0_5b_torch_dist
TOKENIZER_DIR=/models/qwen2_5_0_5b
ROPE_BASE=1000000
ARCH_ARGS="--num-layers 24 --hidden-size 896 --ffn-hidden-size 4864
           --num-attention-heads 14 --group-query-attention --num-query-groups 2
           --kv-channels 64"
SEQ=4096
MBS=1
GBS=8

# Measured across-job ALIGNED reproducibility for this workload class (37 clean same-identity pairs,
# compare_legs.py): median 0.1441%, worst 0.4966%. This is ~6x looser than 7B because host jitter is
# a far larger share of a ~980 ms step (idle 14% vs 2.4%) and does not cancel. 0.5% is the shipped
# default; do NOT pass the 7B value here: at 0.15%, 15 of those 37 known-null pairs read as wins.
# Cheapest improvement is window length, not the band: pairs with both legs >=29 steady steps have
# worst |delta| 0.2544% against 0.4966% when either leg had 19.
ACROSS_JOB_FLOOR_PCT=0.5
