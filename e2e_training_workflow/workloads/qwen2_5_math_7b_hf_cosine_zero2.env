# Pinned workload descriptor: RECOMMENDED HF TRL recipe for 7B (2026-10-17).
# = qwen2_5_math_7b_hf_cosine.env with FSDP shard_grad_op (ZeRO-2) instead of full_shard.
# Measured 2026-10-17 (runs/hffsdp_1017_041203_*): +21.2/+20.8% paired, 1,096 -> 1,338 useful tok/s/GPU,
# peak reserved 73.6 -> 86.5 GB; the training trajectory is BITWISE identical to full_shard (loss and
# grad_norm at all 30 steps, both reps) -- a pure communication change, no numerics. DECISIONS 4.28.
#
WORKLOAD_NAME=qwen2_5_math_7b_hf_cosine_zero2
MODEL_CKPT=/models/qwen2_5_math_7b_torch_dist
TOKENIZER_DIR=/models/qwen2_5_math_7b
ROPE_BASE=10000
ARCH_ARGS="--num-layers 28 --hidden-size 3584 --ffn-hidden-size 18944
           --num-attention-heads 28 --group-query-attention --num-query-groups 4
           --kv-channels 128 --untie-embeddings-and-output-weights"
SEQ=4096
MBS=1
GBS=64

# Measured across-job ALIGNED reproducibility for this workload class (10 clean same-identity pairs,
# compare_legs.py): median 0.0236%, worst 0.0823%. Pass this to the Workflow as
# across_job_floor_pct to recover sub-0.5% wins the default (0.5%, sized for the noisier 0.5B class)
# would discard. 0.15% keeps ~1.8x margin over the worst observation.
ACROSS_JOB_FLOOR_PCT=0.25

# HF stack + standard schedule (see header).
HF_FSDP=shard_grad_op
LR=1.0e-5
MIN_LR=1.0e-6
LR_DECAY_STYLE=cosine
LR_WARMUP_ITERS=9
LR_DECAY_ITERS=312
