# Pinned workload descriptor: _cosine_avg with the model's OWN RMSNorm epsilon (2026-10-23, DECISIONS 4.55).
#
# NOT RECOMMENDED. Outcome test P0-4l: held-out loss +0.0067 WORSE than _cosine_avg (eps 1e-5) on 5/5
# seeds, one catastrophic late episode. Kept as the measured alternative; production = _cosine_avg.
#
# = qwen2_5_math_7b_packed_cosine_avg.env (left byte-identical: P0-4e/P0-4f and the s8 bundle were
# judged under its identity) + NORM_EPS=1e-6.
#   Qwen2.5-Math-7B was trained with rms_norm_eps 1e-6 (config.json). Megatron does not read the
#   epsilon from the torch_dist checkpoint (common.pt args: norm_epsilon None) and defaults to 1e-5,
#   so every Megatron leg before this descriptor fine-tuned the model with a different normalization
#   than it was pretrained with (realized `layernorm_epsilon 1e-05` in every train.log). HF/TRL legs
#   always ran 1e-6. Implemented as the owner-approved fix (review 2026-10-23, step 3), then measured.
#
WORKLOAD_NAME=qwen2_5_math_7b_packed_cosine_avg_eps6
MODEL_CKPT=/models/qwen2_5_math_7b_torch_dist
TOKENIZER_DIR=/models/qwen2_5_math_7b
ROPE_BASE=10000
ARCH_ARGS="--num-layers 28 --hidden-size 3584 --ffn-hidden-size 18944
           --num-attention-heads 28 --group-query-attention --num-query-groups 4
           --kv-channels 128 --untie-embeddings-and-output-weights"
SEQ=4096
MBS=1

# GBS COUNTS PACKS. 16 packs ~= 53 conversations per optimizer step. CONFIRMED 2026-10-15
# (DECISIONS 4.21): closest to the LR-tuned 64 conversations without exceeding it.
GBS=16

# The packed dataset -- only if the caller did not pass --data. This file is sourced AFTER argument
# parsing, so a plain assignment here would silently override an explicit --data.
_PACKED=/work/data/sft_ultrachat20k_packed_7b_cfg1009.jsonl
[ "$DATA_PATH" = /work/data/sft_ultrachat20k.jsonl ] && DATA_PATH="$_PACKED"

# Across-job floor. Three same-identity null pairs of THIS descriptor (two jobs today plus one from
# an earlier session): paired deltas +0.030, -0.036, +0.009%; throughput 2874.2 / 2874.4 / 2874.5.
# Three pairs are too few to set a floor on their own, so this takes the unpacked 7B floor, which
# 400 clean pairs put at 0.25% (worst 0.225%) -- 7x the worst packed null seen. Re-run
# scripts/calibrate_band.py once this descriptor has more legs and tighten it on evidence.
ACROSS_JOB_FLOOR_PCT=0.30   # per-stack Megatron floor since DECISIONS 4.54

# Standard LR schedule (see header). Read by scripts/adapters/megatron.sh; absent in older descriptors,
# where the adapter keeps its historical constant-LR defaults.
LR=1.0e-5
MIN_LR=1.0e-6
LR_DECAY_STYLE=cosine
LR_WARMUP_ITERS=11
LR_DECAY_ITERS=358

# Accepted DP-communication lever (see header). Read by scripts/adapters/megatron.sh; empty elsewhere.
DDP_EXTRA_ARGS="--ddp-average-in-collective"

# Model-matched RMSNorm epsilon (see header). Read by scripts/adapters/megatron.sh as --norm-epsilon.
NORM_EPS=1e-6
