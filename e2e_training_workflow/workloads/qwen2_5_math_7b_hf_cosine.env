# Pinned workload descriptor: the 7B UNPACKED workload for the SECOND STACK (HF TRL), 2026-10-16.
#
# = qwen2_5_math_7b.env (same model, data, GBS 64 conversations, seq 4096) plus what the HF stack needs
# and the standard LR schedule (user rule 2026-10-16: default practice incl. warmup, fixed while
# optimising):
#   HF_FSDP=full_shard   -- with fp32 master weights DDP replicates weights+grads+AdamW and OOMs at 7B
#   warmup 9 iters (3% of one epoch = 20000/64 = 312 updates), cosine decay to 10% of the 1e-5 peak.
# Use with --stack hf_trl. Read by scripts/adapters/hf_trl.sh (HF_FSDP, LR*); the Megatron adapter
# ignores HF_FSDP.
#
WORKLOAD_NAME=qwen2_5_math_7b_hf_cosine
MODEL_CKPT=/models/qwen2_5_math_7b_torch_dist
TOKENIZER_DIR=/models/qwen2_5_math_7b
ROPE_BASE=10000
ARCH_ARGS="--num-layers 28 --hidden-size 3584 --ffn-hidden-size 18944
           --num-attention-heads 28 --group-query-attention --num-query-groups 4
           --kv-channels 128 --untie-embeddings-and-output-weights"
SEQ=4096
MBS=1
GBS=64

# Measured across-job ALIGNED reproducibility for this workload class (10 clean same-identity pairs,
# compare_legs.py): median 0.0236%, worst 0.0823%. Pass this to the Workflow as
# across_job_floor_pct to recover sub-0.5% wins the default (0.5%, sized for the noisier 0.5B class)
# would discard. 0.15% keeps ~1.8x margin over the worst observation.
ACROSS_JOB_FLOOR_PCT=0.25

# HF stack + standard schedule (see header).
HF_FSDP=full_shard
LR=1.0e-5
MIN_LR=1.0e-6
LR_DECAY_STYLE=cosine
LR_WARMUP_ITERS=9
LR_DECAY_ITERS=312
